rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Function to check if it's the owner of the document (matching UID)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Scores Collection
    match /scores/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // 2. Profiles Collection
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // 3. Social Messages (permite actualizar para despublicar/ocultar)
    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.text.size() <= 100;
      allow update: if isAuthenticated();
      allow delete: if false; // Admin only via console o lógica futura
    }

    // 4. News Collection
    match /news/{newsId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 5. Homenajes Collection
    match /homenajes/{homenajeId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 6. Media Metadata (fotos: crear, actualizar visible/despublicar, borrar)
    match /media/{mediaId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // 7. Configs
    match /configs/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 8. Trivia (preguntas y videos para el juego)
    match /trivia_questions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    match /trivia_videos/{videoId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 9. Misiones (Marketing) — CRUD desde admin
    match /missions/{missionId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // 10. Progreso de misiones por usuario
    match /mission_progress/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 11. Asignación de 13 misiones al azar por usuario
    match /mission_assignments/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
